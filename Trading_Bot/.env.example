FMP_API_KEY=

# Gmail SMTP defaults shown; use a 16-character App Password (requires 2FA
# enabled on the account), not the account's regular login password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jctradingalert@gmail.com
SMTP_PASS=
EMAIL_FROM=jctradingalert@gmail.com
EMAIL_TO=jctradingalert@gmail.com

# Optional: Railway Postgres plugin injects this automatically. If unset, state
# is kept in a local SQLite file at data/state.db (fine for local testing only —
# Railway cron containers are ephemeral, so Postgres is required in production).
DATABASE_URL=

TOP_N_SECTORS=3
