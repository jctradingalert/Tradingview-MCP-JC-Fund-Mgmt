# Set these in Railway dashboard → Service → Variables
# ── Required ──────────────────────────────────────────────────────────────────
LOCAL_RELAY_URL=https://relay.jcfmonline.com
RELAY_SECRET=change-me-to-a-long-random-string

# Internal Railway URL of the TV MCP service (same project, private networking)
# In Railway dashboard reference it as: ${{<tv-mcp-service-name>.RAILWAY_PRIVATE_DOMAIN}}
TV_MCP_URL=http://tradingview-mcp.railway.internal:8000

# ── Optional ──────────────────────────────────────────────────────────────────
# TradingView alerts must include ?secret=<value> in the webhook URL
TV_WEBHOOK_SECRET=

# Alpaca HMAC signing secret — from Alpaca dashboard → Webhooks
ALPACA_SIGNING_SECRET=
